{
  "schema_version": 2,
  "bundle": {
    "artifact_name": "release-bundle",
    "download_pattern": "cibw-*"
  },
  "python": {
    "abi_policy": "per-cpython",
    "supported_versions": [
      "3.10",
      "3.11",
      "3.12",
      "3.13",
      "3.14"
    ]
  },
  "distributions": [
    {
      "name": "gafime",
      "package": "gafime",
      "wheel_prefix": "gafime",
      "kind": "core",
      "backend": null,
      "policy": "core-with-metal-on-apple-silicon",
      "standard_bundle": true,
      "pypi": {
        "wheels": true,
        "sdist": true
      },
      "extra": null,
      "sdist": {
        "artifact": "cibw-sdist",
        "build_job": "build_sdist"
      },
      "wheels": [
        {
          "platform": "manylinux_2_28_x86_64",
          "artifact": "cibw-wheels-linux-x86_64",
          "build_job": "build_wheels",
          "validation_job": "validate_wheels",
          "validation_label": "linux-x86_64",
          "python_versions": "all",
          "validation_limit": null,
          "embedded_backends": [],
          "filename_template": "gafime-*-{python_tag}-{python_tag}-manylinux_2_28_x86_64.whl"
        },
        {
          "platform": "manylinux_2_28_aarch64",
          "artifact": "cibw-wheels-ubuntu-24.04-arm",
          "build_job": "build_arm_linux_wheels",
          "validation_job": "validate_wheels",
          "validation_label": "linux-aarch64",
          "python_versions": "all",
          "validation_limit": null,
          "embedded_backends": [],
          "filename_template": "gafime-*-{python_tag}-{python_tag}-manylinux_2_28_aarch64.whl"
        },
        {
          "platform": "macosx_11_0_arm64",
          "artifact": "cibw-wheels-macos-arm64",
          "build_job": "build_wheels",
          "validation_job": "validate_wheels",
          "validation_label": "macos-arm64",
          "python_versions": "all",
          "validation_limit": null,
          "embedded_backends": [
            "metal"
          ],
          "filename_template": "gafime-*-{python_tag}-{python_tag}-macosx_11_0_arm64.whl"
        },
        {
          "platform": "win_amd64",
          "artifact": "cibw-wheels-windows-x86_64",
          "build_job": "build_wheels",
          "validation_job": "validate_wheels",
          "validation_label": "windows-amd64",
          "python_versions": "all",
          "validation_limit": null,
          "embedded_backends": [],
          "filename_template": "gafime-*-{python_tag}-{python_tag}-win_amd64.whl"
        },
        {
          "platform": "win_arm64",
          "artifact": "cibw-wheels-windows-11-arm",
          "build_job": "build_arm_windows_wheels",
          "validation_job": "validate_windows_arm_wheel",
          "validation_label": "windows-arm64",
          "python_versions": [
            "3.11",
            "3.12",
            "3.13",
            "3.14"
          ],
          "validation_limit": "actions/python-versions does not publish a native Windows ARM64 CPython 3.10 runtime.",
          "embedded_backends": [],
          "filename_template": "gafime-*-{python_tag}-{python_tag}-win_arm64.whl"
        }
      ]
    },
    {
      "name": "gafime-cuda",
      "package": "gafime_cuda",
      "wheel_prefix": "gafime_cuda",
      "kind": "payload",
      "backend": "cuda",
      "policy": "system",
      "standard_bundle": true,
      "pypi": {
        "wheels": true,
        "sdist": true
      },
      "extra": null,
      "sdist": {
        "artifact": "cibw-cuda-sdist",
        "build_job": "build_cuda_payload_sdist"
      },
      "wheels": [
        {
          "platform": "manylinux_2_28_x86_64",
          "artifact": "cibw-cuda-linux-wheels",
          "build_job": "build_cuda_payload_wheels",
          "validation_job": "validate_cuda_payload_wheels",
          "validation_label": "cuda-linux",
          "python_versions": "all",
          "validation_limit": null,
          "embedded_backends": [],
          "filename_template": "gafime_cuda-*-{python_tag}-{python_tag}-*manylinux_2_28_x86_64.whl"
        },
        {
          "platform": "win_amd64",
          "artifact": "cibw-cuda-windows-wheels",
          "build_job": "build_cuda_payload_wheels",
          "validation_job": "validate_cuda_payload_wheels",
          "validation_label": "cuda-windows",
          "python_versions": "all",
          "validation_limit": null,
          "embedded_backends": [],
          "filename_template": "gafime_cuda-*-{python_tag}-{python_tag}-win_amd64.whl"
        }
      ]
    },
    {
      "name": "gafime-rocm",
      "package": "gafime_rocm",
      "wheel_prefix": "gafime_rocm",
      "kind": "payload",
      "backend": "rocm",
      "policy": "system",
      "standard_bundle": true,
      "pypi": {
        "wheels": false,
        "sdist": true
      },
      "extra": null,
      "sdist": {
        "artifact": "cibw-rocm-sdist",
        "build_job": "build_rocm_payload_sdist"
      },
      "wheels": [
        {
          "platform": "linux_x86_64",
          "artifact": "cibw-rocm-linux-wheels",
          "build_job": "build_rocm_linux_payload_wheels",
          "validation_job": "validate_rocm_payload_wheels",
          "validation_label": "rocm-linux",
          "python_versions": "all",
          "validation_limit": null,
          "embedded_backends": [],
          "filename_template": "gafime_rocm-*-{python_tag}-{python_tag}-linux_x86_64.whl"
        }
      ]
    }
  ]
}
